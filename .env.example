# rip-maf — copy to .env and edit.

# Host-side published ports (loopback only).
HOST_BACKEND_PORT=8000
HOST_PG_PORT=5432

# Database. Host-local runs use 127.0.0.1 + HOST_PG_PORT; compose backend
# uses DB_HOST=postgres:5432 (set in docker-compose.yml).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ripmaf
DB_USER=ripmaf
DB_PASSWORD=ripmafpass
DB_CONNECT_TIMEOUT_S=5

# Ollama (sole LLM).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_MS=120000

# BGE embedding + reranker weights.
# Host-local: absolute paths to the model dirs.
# Compose: BGE_MODELS_DIR is mounted at /app/models (paths overridden there).
BGE_MODELS_DIR=./models
BGE_M3_MODEL_PATH=C:/Users/you/models/bge-m3
BGE_RERANKER_V2_M3=C:/Users/you/models/reranker/bge_reranker_v2_m3

# PDF ingestion: docling | opendataloader (selected runs first, other fallback).
RAG_PDF_LOADER=docling

# Context window (must equal the Ollama server's OLLAMA_CONTEXT_LENGTH).
OLLAMA_CONTEXT_WINDOW=32768
# Whole-file RAG shortcut share of the window (0 disables).
RAG_WHOLE_FILE_PCT=0.15

# Server
PORT=8000
LOG_LEVEL=INFO
UPLOAD_DIR=./uploads

# Auth: shared secret the Open WebUI Pipe sends as X-RIP-Service-Key.
# Generate a random value; set the same in the Pipe's RIP_SERVICE_KEY.
RIP_SERVICE_KEY=change-me-rip-maf-service-key

# Observability (optional; no-op unless ENABLED=true + keys).
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=dev
